# Copy this file to .env and fill in values for your local environment.
# .env is gitignored — never commit real secrets.

# 1. Database — required for the app to start (every page calls connectDB)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>"

# 2. Auth — required to log in, sign up, or hit a protected route
NEXT_PUBLIC_DOMAIN="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# 3. Cloudinary — CLOUDINARY_CLOUD_NAME is required for the app to start
#    (next.config.mjs scopes the image optimizer to this one account, and
#    refuses to build without it); all three are required to add or edit a
#    product (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Stripe — required for real payments at checkout (Phase 1B onwards).
#    Leave STRIPE_SECRET_KEY unset to run in stub mode: the customer is
#    redirected to /checkout/stripe-mock (a local stand-in for Stripe's
#    hosted page) instead of the real Stripe API. Useful for portfolio
#    demos when sandbox keys live on a different project.
#    Test-mode keys start with `sk_test_` / `whsec_`. Get them from
#    https://dashboard.stripe.com/test/apikeys after creating a test account.
#    The webhook secret comes from the CLI (`stripe listen`) or a configured
#    endpoint at https://dashboard.stripe.com/test/webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 5. Resend — email transport. Provisioned but not yet wired to any send
#    path: nothing in the app sends mail today. Documented here so the key
#    isn't an undocumented value sitting in .env and Vercel. Order
#    confirmation email (MVP roadmap) is the first intended consumer.
#    Create a key at https://resend.com/api-keys with *Sending access* only;
#    this app never reads your Resend account. Keys start with `re_`.
#
#    RESEND_FROM is the sender. This project uses Resend's shared test
#    sender, which needs no domain verification — but it ONLY delivers to
#    the address that owns the Resend account. Every other recipient gets
#    silence while the API still reports success.
#
#    That is fine while nothing sends mail. Before wiring any customer-facing
#    send path (order confirmation, order status), verify a domain at
#    https://resend.com/domains and switch this to an address on it, e.g.
#    "EliteCuts <no-reply@yourdomain.com>" — otherwise customers silently
#    never receive anything.
RESEND_API_KEY=
RESEND_FROM="EliteCuts <onboarding@resend.dev>"

# 6. Vercel Cron — shared secret the daily dormancy scan and the hard-delete
#    purge endpoint compare against the `Authorization: Bearer …` header.
#    The comparison is constant-time. Vercel Cron sets this for you when the
#    cron job is configured in vercel.json; locally, set any random value to
#    test the cron endpoints with `curl -H "Authorization: Bearer <value>"`.
CRON_SECRET=

# 7. Public URLs — inlined into the client bundle at build time (rebuild after changing)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=

# 8. Portfolio-only flags — leave unset on any production / real-money deploy.
#    Demo Card tile at checkout creates a paid order without ever charging a
#    card. On in dev/test by default so the portfolio demo works without
#    Stripe sandbox keys; off in production unless explicitly set to 'true'.
#    Set to 'false' to force it off in dev too. Server-only (no NEXT_PUBLIC_
#    prefix) — the checkout server component reads it and threads the boolean
#    down to client components as a prop.
ENABLE_DEMO_CARD_TILE=
